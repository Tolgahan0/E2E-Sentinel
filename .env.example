# Copy this file to .env and fill in real values. Never commit .env.
#
# These variables configure E2E Sentinel's OWN Postgres/Redis instances,
# not any target project under test.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# debug | info | warn | error
SENTINEL_LOG_LEVEL=info

# Free-form label for this deployment, shown in logs/dashboard only.
# Distinct from the per-project Environment entity (local/dev/staging/production)
# introduced in later phases.
SENTINEL_ENVIRONMENT=local

# Phase 5 (test execution) settings — all optional, shown with their
# defaults. SENTINEL_RUNNER_HOST_WORKSPACE_DIR is NOT set here; `make up`
# computes it automatically as an absolute host path. See
# docs/RUNNER_ISOLATION.md.
# SENTINEL_RUNNER_IMAGE=e2e-sentinel-playwright-runner:latest
# SENTINEL_RUNNER_TIMEOUT_SECONDS=120
