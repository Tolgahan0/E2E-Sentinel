# Copy this file to .env and fill in real values. Never commit .env.
#
# These variables configure E2E Sentinel's OWN Postgres/Redis instances,
# not any target project under test.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# debug | info | warn | error
SENTINEL_LOG_LEVEL=info

# Free-form label for this deployment, shown in logs/dashboard only.
# Distinct from the per-project Environment entity (local/dev/staging/production)
# introduced in later phases.
SENTINEL_ENVIRONMENT=local

# Phase 5 (test execution) settings — all optional, shown with their
# defaults. SENTINEL_RUNNER_HOST_WORKSPACE_DIR is NOT set here; `make up`
# computes it automatically as an absolute host path. See
# docs/RUNNER_ISOLATION.md.
# SENTINEL_RUNNER_IMAGE=e2e-sentinel-playwright-runner:latest
# SENTINEL_RUNNER_TIMEOUT_SECONDS=120

# Phase 6 (AI providers) — optional. Leave unset to run with AI disabled
# entirely (spec §16.6 "No-AI Mode"); every other feature works fine
# without it. Set this to store an API key for a hosted provider
# (OpenAI, Anthropic, Gemini, Azure OpenAI). A keyless local Ollama
# provider can be configured either way. Generate a key with:
#   openssl rand -base64 32
# SENTINEL_SECRET_ENCRYPTION_KEY=

# Phase 8 (fix proposals) — optional, shown with its default. Where a
# fix proposal's diff is applied to a disposable copy of the repository
# before anyone approves writing it for real. See docs/FIX_PROPOSALS.md.
# SENTINEL_FIX_WORKSPACES_DIR=/data/fix-workspaces

# Phase 9 (RBAC) — optional, defaults to disabled. When enabled, set both
# admin variables so a first administrator account can be bootstrapped
# (only happens once, when no users exist yet). See
# docs/SECURITY_MODEL.md.
# SENTINEL_AUTH_ENABLED=true
# SENTINEL_ADMIN_EMAIL=admin@example.com
# SENTINEL_ADMIN_PASSWORD=change-me-and-make-it-long
