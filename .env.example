# Copy this file to .env and fill in real values. Never commit .env.
#
# These variables configure E2E Sentinel's OWN Postgres/Redis instances,
# not any target project under test.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# debug | info | warn | error
SENTINEL_LOG_LEVEL=info

# Free-form label for this deployment, shown in logs/dashboard only.
# Distinct from the per-project Environment entity (local/dev/staging/production)
# introduced in later phases.
SENTINEL_ENVIRONMENT=local

# Phase 5 (test execution) settings — all optional, shown with their
# defaults. SENTINEL_RUNNER_HOST_WORKSPACE_DIR is NOT set here; `make up`
# computes it automatically as an absolute host path. See
# docs/RUNNER_ISOLATION.md.
# SENTINEL_RUNNER_IMAGE=e2e-sentinel-playwright-runner:latest
# SENTINEL_RUNNER_TIMEOUT_SECONDS=120
# Phase 11 WebSocket adapter — shares SENTINEL_RUNNER_HOST_WORKSPACE_DIR
# above with the Playwright runner, just a different sub-image.
# SENTINEL_WEBSOCKET_RUNNER_IMAGE=e2e-sentinel-websocket-runner:latest

# docker | local | auto (default). "docker" always uses disposable
# per-run containers (never falls back if unavailable). "local" always
# runs a test as a plain host process instead — no container, no Docker
# socket, but requires `playwright`/`node` installed directly on
# whatever host sentinel-api itself runs on, and gives up per-run
# isolation. "auto" uses docker when SENTINEL_RUNNER_HOST_WORKSPACE_DIR
# is set and the daemon answers, otherwise falls back to local
# automatically. See docs/RUNNER_ISOLATION.md.
# SENTINEL_EXECUTION_MODE=auto

# Phase 6 (AI providers) — optional. Leave unset to run with AI disabled
# entirely (spec §16.6 "No-AI Mode"); every other feature works fine
# without it. Set this to store an API key for a hosted provider
# (OpenAI, Anthropic, Gemini, Azure OpenAI). A keyless local Ollama
# provider can be configured either way. Generate a key with:
#   openssl rand -base64 32
# SENTINEL_SECRET_ENCRYPTION_KEY=

# Phase 8 (fix proposals) — optional, shown with its default. Where a
# fix proposal's diff is applied to a disposable copy of the repository
# before anyone approves writing it for real. See docs/FIX_PROPOSALS.md.
# SENTINEL_FIX_WORKSPACES_DIR=/data/fix-workspaces

# Phase 9 (RBAC) — optional, defaults to disabled. When enabled, set both
# admin variables so a first administrator account can be bootstrapped
# (only happens once, when no users exist yet). See
# docs/SECURITY_MODEL.md.
# SENTINEL_AUTH_ENABLED=true
# SENTINEL_ADMIN_EMAIL=admin@example.com
# SENTINEL_ADMIN_PASSWORD=change-me-and-make-it-long

# Phase 10 (Kubernetes discovery) — optional, defaults to disabled.
# SENTINEL_KUBE_CONFIG_HOST_PATH is a HOST path to a kubeconfig file
# (docker-compose.yml mounts it read-only into the container);
# SENTINEL_KUBE_CONFIG_PATH is where the API process reads it from
# INSIDE the container (must match the mount target, /kube/config).
# Leave both unset to disable, or leave SENTINEL_KUBE_CONFIG_PATH unset
# while running sentinel-api itself inside a cluster with a projected
# ServiceAccount token — that's auto-detected instead. See
# docs/KUBERNETES_DISCOVERY.md.
# SENTINEL_KUBE_CONFIG_HOST_PATH=/Users/you/.kube/config
# SENTINEL_KUBE_CONFIG_PATH=/kube/config
# SENTINEL_KUBE_NAMESPACE=default

# Update checking (GET /version) — optional, defaults to enabled. A
# periodic, read-only GET against GitHub's public Releases API to see
# whether a newer E2E Sentinel version exists than the one running;
# surfaced as a small notice on the panel's Dashboard and printed by
# scripts/onboard.sh. Sends no project data. Set to false for an
# air-gapped deployment with no outbound internet access.
# SENTINEL_UPDATE_CHECK_ENABLED=true

# GitHub CI integration — optional, defaults to disabled. Polls (never
# receives a webhook — see docs/GITHUB_CI.md for why) each configured
# project's default branch for a new commit, runs its approved test
# cases, and reports a commit status back. Also needs
# SENTINEL_SECRET_ENCRYPTION_KEY set (above) — a project's GitHub token
# is stored the same way an AI provider's API key is.
# SENTINEL_GITHUB_CI_ENABLED=true
# SENTINEL_GITHUB_CI_POLL_SECONDS=90
