# Secrets
.env
.env.local

# Target repositories placed here for Docker-mode discovery (see
# docs/LOCAL_DEVELOPMENT.md) — never part of E2E Sentinel's own source.
/workspace/*
!/workspace/.gitkeep

# Generated test specs written here per run (Phase 5), shared with
# disposable runner containers — never part of E2E Sentinel's own source.
/runner-workspaces/*
!/runner-workspaces/.gitkeep

# Go
apps/api/sentinel
*.test

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Logs
*.log
